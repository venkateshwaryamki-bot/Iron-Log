{
  "name": "Ironlog — Workout Tracker",
  "short_name": "Ironlog",
  "description": "Plan your week, log sets and track progressive overload.",
  "id": "./",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121316",
  "theme_color": "#121316",
  "categories": ["health", "fitness", "sports"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start workout", "url": "./#/workout", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "History", "url": "./#/history", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
